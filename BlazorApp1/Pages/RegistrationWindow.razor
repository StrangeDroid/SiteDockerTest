@page "/registration"
@using Npgsql
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<RegistrationWindow> Localizer
@using BlazorApp1.Data
@inject DbConnectionFactory DbFactory
@inject ICurrentUserService CurrentUserSvc
@code {
    private bool isRegistering = false;
    private string debug = "";
    private string login;
    private string password;

    private string regUsername;
    private string regEmail;
    private string regPassword;

    private bool showError = false;
    private string errorMessage = "";


    private void StartRegistration()
    {
        isRegistering = true;
    }

    private const int TokenLifetimeDays = 7;
    // Типы цветов, которые получает новый игрок (слоты 0 и 1)
    private static readonly int[] StarterFlowerTypes = { 8, 9 };

    private void ShowError(string message)
    {
        errorMessage = message;
        showError = true;
    }

    private async Task SubmitLogin()
    {
        if (string.IsNullOrWhiteSpace(login) || string.IsNullOrWhiteSpace(password))
            return;

        try
        {
            using var conn = DbFactory.Create();
            await conn.OpenAsync();

            int userId;
            using (var cmd = new NpgsqlCommand("SELECT id, password_hash FROM users WHERE username = @login", conn))
            {
                cmd.Parameters.AddWithValue("@login", login);
                using var reader = await cmd.ExecuteReaderAsync();
                if (!await reader.ReadAsync())
                {
                    ShowError("❌ Пользователь не найден");
                    return;
                }
                if (!PasswordHasher.Verify(password, reader.GetString(1)))
                {
                    ShowError("❌ Неверный пароль");
                    return;
                }
                userId = reader.GetInt32(0);
            }

            await CreateSessionAsync(conn, userId);
            CurrentUserSvc.User = await UserRepository.LoadUserById(userId, conn);
            CurrentUserSvc.User.IsNewUser = false;

            Navigation.NavigateTo("/main");
        }
        catch (Exception ex)
        {
            ShowError($"❌ Ошибка: {ex.Message}");
        }
    }

    // Заменяет старые токены пользователя новым и сохраняет его в cookie
    private async Task CreateSessionAsync(NpgsqlConnection conn, int userId)
    {
        using (var deleteCmd = new NpgsqlCommand("DELETE FROM authtokens WHERE user_id = @uid", conn))
        {
            deleteCmd.Parameters.AddWithValue("@uid", userId);
            await deleteCmd.ExecuteNonQueryAsync();
        }

        var token = Guid.NewGuid().ToString();
        using (var insertCmd = new NpgsqlCommand("INSERT INTO authtokens (user_id, token, expires_at) VALUES (@uid, @token, @exp)", conn))
        {
            insertCmd.Parameters.AddWithValue("@uid", userId);
            insertCmd.Parameters.AddWithValue("@token", token);
            insertCmd.Parameters.AddWithValue("@exp", DateTime.UtcNow.AddDays(TokenLifetimeDays));
            await insertCmd.ExecuteNonQueryAsync();
        }

        await JS.InvokeVoidAsync("CookieHelper.set", "authToken", token, TokenLifetimeDays);
    }

    private async Task SubmitRegistration()
    {
        if (string.IsNullOrWhiteSpace(regUsername) || string.IsNullOrWhiteSpace(regPassword))
            return;

        // Проверка email: обязателен и должен быть корректным
        var email = regEmail?.Trim().ToLowerInvariant() ?? "";
        if (email.Length == 0)
        {
            debug = "❗ Введите email";
            return;
        }
        if (email.Length > 100 || !IsValidEmail(email))
        {
            debug = "❗ Некорректный email";
            return;
        }

        try
        {
            using var conn = DbFactory.Create();
            await conn.OpenAsync();

            // Проверка существующего имени
            using (var checkCmd = new NpgsqlCommand("SELECT COUNT(*) FROM users WHERE username = @username", conn))
            {
                checkCmd.Parameters.AddWithValue("@username", regUsername);
                if (Convert.ToInt32(await checkCmd.ExecuteScalarAsync()) > 0)
                {
                    debug = "❗ Такой пользователь уже существует";
                    return;
                }
            }

            // Проверка существующего email
            using (var emailCheckCmd = new NpgsqlCommand("SELECT COUNT(*) FROM users WHERE LOWER(email) = @email", conn))
            {
                emailCheckCmd.Parameters.AddWithValue("@email", email);
                if (Convert.ToInt32(await emailCheckCmd.ExecuteScalarAsync()) > 0)
                {
                    debug = "❗ Этот email уже зарегистрирован";
                    return;
                }
            }

            // Пользователь, стартовые цветы и токен создаются вместе или не создаются вовсе
            using var tx = await conn.BeginTransactionAsync();

            int userId;
            using (var insertCmd = new NpgsqlCommand("INSERT INTO users (username, email, password_hash) VALUES (@username, @email, @password) RETURNING id", conn))
            {
                insertCmd.Parameters.AddWithValue("@username", regUsername);
                insertCmd.Parameters.AddWithValue("@email", email);
                insertCmd.Parameters.AddWithValue("@password", PasswordHasher.Hash(regPassword));
                userId = Convert.ToInt32(await insertCmd.ExecuteScalarAsync());
            }

            for (int slot = 0; slot < StarterFlowerTypes.Length; slot++)
            {
                using var flowerInsert = new NpgsqlCommand("INSERT INTO flowers (user_id, type_id, hp, pot_slot) VALUES (@uid, @type, @hp, @slot)", conn);
                flowerInsert.Parameters.AddWithValue("@uid", userId);
                flowerInsert.Parameters.AddWithValue("@type", StarterFlowerTypes[slot]);
                flowerInsert.Parameters.AddWithValue("@hp", 9);
                flowerInsert.Parameters.AddWithValue("@slot", slot);
                await flowerInsert.ExecuteNonQueryAsync();
            }

            await CreateSessionAsync(conn, userId);
            await tx.CommitAsync();

            // Загружаем из БД, чтобы у цветов были настоящие id, названия и цены
            CurrentUserSvc.User = await UserRepository.LoadUserById(userId, conn);
            CurrentUserSvc.User.IsNewUser = true;

            debug = "✅ Регистрация завершена";
            isRegistering = false;
            Navigation.NavigateTo("/main");
        }
        catch (PostgresException ex) when (ex.SqlState == PostgresErrorCodes.UniqueViolation)
        {
            // Одновременная регистрация с тем же именем/email
            debug = ex.ConstraintName == "ux_users_email"
                ? "❗ Этот email уже зарегистрирован"
                : "❗ Такой пользователь уже существует";
        }
        catch (Exception ex)
        {
            // Форма остаётся открытой, чтобы ошибка была видна
            debug = $"❌ Ошибка: {ex.Message}";
        }
    }

    private static bool IsValidEmail(string email)
    {
        try
        {
            var addr = new System.Net.Mail.MailAddress(email);
            // MailAddress принимает и "Имя <a@b.ru>", поэтому сверяем адрес целиком
            return addr.Address == email && email.Contains('.', StringComparison.Ordinal);
        }
        catch (FormatException)
        {
            return false;
        }
    }

}

@if (showError)
{
    <div class="modal-overlay"></div>
    <div class="modal error-modal show">
        <button class="close-btn" @onclick="() => showError = false">×</button>
        <h3 class="modal-title">@Localizer["EntryError"]</h3>
        <p>@errorMessage</p>
    </div>
}
@if (!isRegistering)
{
    <div class="login-background">
        <img src="images/background/menu.png" alt="Background" class="background-image" />
        <div class="login-container">
            <h2>@Localizer["GameTiltle"]</h2>
            <input @bind="login" placeholder="@Localizer["LoginPlaseholder"]" />
            <input @bind="password" type="password" placeholder="@Localizer["PasswordPlaseholder"]" />
            <div class="button-container">
                <button @onclick="SubmitLogin">@Localizer["SignInButton"]</button>
                <button @onclick="StartRegistration">@Localizer["RegisterButton"]</button>
            </div>
        </div>
    </div>

}
else
{
    <pre style="color:red">@debug</pre>
    <div class="modal-overlay"></div>
    <div class="modal show">
        <button class="close-btn" @onclick="() => isRegistering = false">×</button>
        <h3 class="modal-title">Регистрация</h3>
        <div class="modal-form">
            <input @bind="regUsername" placeholder="Имя пользователя" />
            <input @bind="regEmail" type="email" placeholder="Email" required />
            <input @bind="regPassword" type="password" placeholder="Пароль" />
            <div class="button-container">
                <button class="primary-btn" @onclick="SubmitRegistration">Зарегистрироваться</button>
                <button class="back-btn" @onclick="() => isRegistering = false">Назад</button>
            </div>
        </div>
    </div>
}
